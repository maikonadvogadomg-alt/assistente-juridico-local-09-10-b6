# ─────────────────────────────────────────────────────────────────────────
#  CHAVES DO ASSISTENTE JURÍDICO
#  1) Faça uma cópia deste arquivo com o nome  .env  (só ".env", sem "exemplo")
#  2) Preencha só o que você usa. Linha começando com # é ignorada.
#  3) NUNCA mande o arquivo .env para ninguém nem para o GitHub.
#  Muitas chaves (IA, DataJud…) também dá para colocar pela tela do app.
# ─────────────────────────────────────────────────────────────────────────

# Senha para entrar no app (deixe vazio para não pedir senha)
APP_PASSWORD=

# Porta (endereço http://localhost:5000)
PORT=5000

# IA padrão (compatível com OpenAI: Groq, OpenRouter, OpenAI…)
# Ex. Groq: PUBLIC_API_URL=https://api.groq.com/openai/v1
PUBLIC_API_URL=
PUBLIC_API_KEY=
PUBLIC_API_MODEL=

# Consulta processual (DataJud/CNJ)
DATAJUD_API_KEY=

# Pesquisa (Perplexity) — opcional
PERPLEXITY_API_KEY=

# PDPJ: chave privada PEM numa linha só, trocando as quebras de linha por \n
PDPJ_PEM_PRIVATE_KEY=
